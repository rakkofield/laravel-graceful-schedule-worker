{
    "name": "rakko-inc/laravel-graceful-schedule-worker",
    "description": "",
    "license": "MIT",
    "authors": [],
    "require": {
        "php": "^7.2.5 || ~8.0",
        "illuminate/console": "^6.0 || ^7.0",
        "illuminate/support": "^6.0 || ^7.0",
        "illuminate/cache": "^6.0 || ^7.0",
        "symfony/process": "^4.4 || ^5.4",
        "symfony/console": "^4.4 || ^5.4",
        "dragonmantank/cron-expression": "^2.3.1 || ^3.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "ext-pcntl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.40 || ^9.6.21",
        "illuminate/container": "^6.0 || ^7.0",
        "illuminate/redis": "^6.0 || ^7.0",
        "aws/aws-sdk-php": "^3.20.1",
        "ext-redis": "*"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required for Step Functions dispatcher (^3.20.1)"
    },
    "autoload": {
        "psr-4": {
            "RakkoInc\\LaravelGracefulScheduleWorker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RakkoInc\\LaravelGracefulScheduleWorker\\": [
                "tests/Unit/",
                "tests/Integration/",
                "tests/Helper/"
            ],
            "RakkoInc\\LaravelGracefulScheduleWorker\\E2E\\": "tests/E2E/"
        }
    },
    "config": {
        "audit": {
            "ignore": [
                "PKSA-dxyf-6n16-t87m",
                "PKSA-n3s6-289w-qtqb",
                "PKSA-stsw-jsf7-f6vs"
            ]
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RakkoInc\\LaravelGracefulScheduleWorker\\Providers\\GracefulScheduleWorkerProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@stepfunctions:up",
            "@redis:up",
            "phpunit --testdox"
        ],
        "redis:up": "docker compose up redis -d --wait",
        "redis:down": "docker compose stop redis",
        "test:coverage": "XDEBUG_MODE=coverage php -dzend_extension=xdebug.so ./vendor/bin/phpunit --coverage-text",
        "test:coverage-html": "XDEBUG_MODE=coverage php -dzend_extension=xdebug.so ./vendor/bin/phpunit --coverage-html coverage",
        "stepfunctions:up": "docker compose up -d --wait",
        "stepfunctions:down": "docker compose down",
        "skeleton:update": "cd skeleton && rm -rf vendor/rakko-inc && composer install --no-interaction",
        "tools:install": "cd tools && composer install --no-interaction --ignore-platform-reqs",
        "phpstan": "${PHP_SA_BINARY:-php} tools/vendor/bin/phpstan analyse -c tools/phpstan.neon --memory-limit=512M",
        "phpcs": "${PHP_SA_BINARY:-php} tools/vendor/bin/phpcs --standard=tools/phpcs.xml",
        "phpcbf": "${PHP_SA_BINARY:-php} tools/vendor/bin/phpcbf --standard=tools/phpcs.xml"
    }
}
