{
    "name": "rakko-inc/laravel-graceful-schedule-worker",
    "description": "",
    "license": "MIT",
    "authors": [],
    "require": {
        "php": "^7.2.5 || ~8.0",
        "illuminate/console": "^6.0 || ^7.0",
        "illuminate/support": "^6.0 || ^7.0",
        "symfony/process": "^4.4 || ^5.4",
        "symfony/console": "^4.4 || ^5.4",
        "ext-pcntl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.40 || ^9.6.21",
        "illuminate/container": "^6.0 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "RakkoInc\\LaravelGracefulScheduleWorker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RakkoInc\\LaravelGracefulScheduleWorker\\Tests\\": "tests/",
            "RakkoInc\\LaravelGracefulScheduleWorker\\Helper\\": "tests/Helper/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RakkoInc\\LaravelGracefulScheduleWorker\\Providers\\GracefulScheduleWorkerProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "test:coverage": "XDEBUG_MODE=coverage php -dzend_extension=xdebug.so ./vendor/bin/phpunit --coverage-text",
        "test:coverage-html": "XDEBUG_MODE=coverage php -dzend_extension=xdebug.so ./vendor/bin/phpunit --coverage-html coverage"
    }
}
