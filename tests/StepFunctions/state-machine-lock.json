{
  "Comment": "Integration-test fixture exercising the AcquireLock + ReleaseLock path. Mirrors demo/stepfunctions/state-machine.json so SFI tests verify that $.dispatchedAt is consumed as :now in the AcquireLock ConditionExpression.",
  "StartAt": "AcquireLock",
  "States": {
    "AcquireLock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "ScheduleExecutionLocks",
        "Item": {
          "lockKey": {"S.$": "$.lockKey"},
          "executionArn": {"S.$": "$$.Execution.Id"},
          "acquiredAt": {"S.$": "$$.State.EnteredTime"},
          "expiresAt": {"N.$": "States.JsonToString($.expiresAt)"}
        },
        "ConditionExpression": "attribute_not_exists(lockKey) OR expiresAt < :now",
        "ExpressionAttributeValues": {
          ":now": {"N.$": "States.JsonToString($.dispatchedAt)"}
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": "$.lockError",
          "Next": "AlreadyRunning"
        }
      ],
      "Next": "ExecuteTask"
    },
    "ExecuteTask": {
      "Type": "Pass",
      "Parameters": {
        "command.$": "$.command",
        "mutexName.$": "$.mutexName",
        "dueAt.$": "$.dueAt"
      },
      "ResultPath": "$.taskResult",
      "Next": "ReleaseLock"
    },
    "ReleaseLock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "ScheduleExecutionLocks",
        "Key": {
          "lockKey": {"S.$": "$.lockKey"}
        }
      },
      "ResultPath": null,
      "End": true
    },
    "AlreadyRunning": {
      "Type": "Succeed"
    }
  }
}
