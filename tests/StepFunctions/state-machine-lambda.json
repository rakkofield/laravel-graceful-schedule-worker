{
  "Comment": "Test state machine that hands the payload off to a Lambda worker",
  "StartAt": "InvokeWorker",
  "States": {
    "InvokeWorker": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "graceful-scheduler-worker",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "workerResult.$": "$.Payload"
      },
      "ResultPath": "$.lambda",
      "End": true
    }
  }
}
