{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Laravel 11+ application used by the E2E tests.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 || ^12.0",
        "laravel/tinker": "^2.9 || ^3.0",
        "rakko-inc/laravel-graceful-schedule-worker": "1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": false,
                "reference": "config",
                "versions": {
                    "rakko-inc/laravel-graceful-schedule-worker": "1.x-dev"
                }
            }
        }
    ]
}
