<?xml version="1.0"?>
<ruleset name="LaravelGracefulScheduleWorker">
    <description>Coding Standard</description>

    <file>../src</file>
    <file>../tests</file>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Allow multiple classes in test files (for test helpers/stubs) -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
